# Table Calculator Deployment Configuration
# Copy this file and update with your actual contract addresses

# Required: Address of the deployed KeyRegistrar contract
# This contract manages cryptographic keys for operators across different operator sets
KEY_REGISTRAR=0x0000000000000000000000000000000000000000

# Required: Address of the deployed AllocationManager contract  
# This contract manages operator registrations and allocations in EigenLayer
ALLOCATION_MANAGER=0x0000000000000000000000000000000000000000

# Optional: Number of blocks to look ahead when fetching minimum slashable stake
# Default: 64 blocks
LOOKAHEAD_BLOCKS=64

# Deployment Configuration
# RPC URL for the target network
RPC_URL=http://localhost:8545

# Private key for deployment (use environment variable or .env file)
# PRIVATE_KEY=0x...

# Optional: Etherscan API key for contract verification
# ETHERSCAN_API_KEY=...

# Optional: Chain ID for verification
# CHAIN_ID=1 